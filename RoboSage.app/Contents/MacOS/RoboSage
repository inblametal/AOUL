#!/bin/bash
# RoboSage Native macOS Window Launcher

PORT=8765
URL="http://127.0.0.1:$PORT/"

# 1. Locate Python 3 binary
PYTHON_BIN=""
for cand in "/Library/Frameworks/Python.framework/Versions/Current/bin/python3" \
            "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3" \
            "/opt/homebrew/bin/python3" \
            "/usr/local/bin/python3" \
            "$(which python3 2>/dev/null)"; do
    if [ -x "$cand" ]; then
        PYTHON_BIN="$cand"
        break
    fi
done

if [ -z "$PYTHON_BIN" ]; then
    osascript -e 'display alert "Python 3 Required" message "Python 3 was not found. Please install Python 3 to run RoboSage."'
    exit 1
fi

# 2. Resolve project directory (prefer live workspace, fallback to bundle)
if [ -d "/Users/apple/.gemini/antigravity/scratch/robosage" ]; then
    ROBO_DIR="/Users/apple/.gemini/antigravity/scratch/robosage"
else
    APP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/.." >/dev/null 2>&1 && pwd )"
    ROBO_DIR="$APP_DIR/Resources/robosage"
fi

# 3. Ensure Ollama 24/7 service is running
mkdir -p "$HOME/Library/Logs/Ollama"
if [ -f "$HOME/Library/LaunchAgents/com.ollama.serve.plist" ]; then
    launchctl bootstrap gui/$(id -u) "$HOME/Library/LaunchAgents/com.ollama.serve.plist" 2>/dev/null || launchctl load "$HOME/Library/LaunchAgents/com.ollama.serve.plist" 2>/dev/null
fi

if ! curl -s -m 1 "http://localhost:11434/api/tags" >/dev/null 2>&1; then
    if [ -x "/usr/local/bin/ollama" ]; then
        ( nohup /usr/local/bin/ollama serve > "$HOME/Library/Logs/Ollama/serve.log" 2>&1 & )
    elif [ -d "/Applications/Ollama.app" ]; then
        open -ga Ollama
    fi
fi

# 4. Always ensure latest server code is active
mkdir -p "$HOME/Library/Logs/RoboSage"
lsof -ti :$PORT | xargs kill -9 2>/dev/null
sleep 0.5

cd "$ROBO_DIR"
( nohup "$PYTHON_BIN" "$ROBO_DIR/run.py" --no-browser --port $PORT > "$HOME/Library/Logs/RoboSage/server.log" 2>&1 & )

# Wait up to 6 seconds for server to start responding
for i in {1..30}; do
    if curl -s -m 1 "$URL" >/dev/null 2>&1; then
        break
    fi
    sleep 0.2
done

# 4. Open in dedicated standalone app window
PROFILE_DIR="$HOME/Library/Application Support/RoboSage/Profile"
mkdir -p "$PROFILE_DIR"

if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args \
        --app="$URL" \
        --user-data-dir="$PROFILE_DIR" \
        --window-size=1380,920 \
        --no-first-run \
        --no-default-browser-check
elif [ -d "/Applications/Microsoft Edge.app" ]; then
    open -na "Microsoft Edge" --args \
        --app="$URL" \
        --user-data-dir="$PROFILE_DIR" \
        --window-size=1380,920
elif [ -d "/Applications/Brave Browser.app" ]; then
    open -na "Brave Browser" --args \
        --app="$URL" \
        --user-data-dir="$PROFILE_DIR" \
        --window-size=1380,920
else
    # Fallback to default browser
    open "$URL"
fi
